<Window x:Class="ContractMonthlyClaimSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContractMonthlyClaimSystem"
        mc:Ignorable="d"
        Title="Contract Monthly Claims System" Height="600" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Lecturer Dashboard">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="Submit a new claim" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content= "Submit new claim" Width="150" Margin="0,0,0,20"/>
                        <TextBlock Text="Upload Supporting Documents" FontWeight="Bold"/>
                        <Button Content="Choose File" Width="120" Margin="0,0,0,10"/>
                        <Button Content="Upload" Width="100"/>
                        <Separator Margin="10"/>


                        <TextBlock Text="My Claims" FontSize="14" FontWeight="Bold"/>
                        <ListView Height="200">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Claim ID" Width="100"/>
                                    <GridViewColumn Header="Date Submitted" Width="150"/>
                                    <GridViewColumn Header="Amount" Width="100"/>
                                    <GridViewColumn Header="Status" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            
            <TabItem Header="Manager Dashboard">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="Pending Claims for approval" FontSize="16" FontWeight="Bold"/>
                        <ListView Height="250">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Claim ID" Width="100"/>
                                    <GridViewColumn Header="Lecturer" Width="150"/>
                                    <GridViewColumn Header="Amount" Width="100"/>
                                    <GridViewColumn Header="Status" Width="100"/>
                                    <GridViewColumn Header="Action" Width="150"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Approval" Width="100" Margin="0,0,10,0"/>
                            <Button Content="Reject" Width="100"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
